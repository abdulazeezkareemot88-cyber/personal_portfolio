* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

.app {
  min-height: 100vh;
  transition: background 0.3s ease, color 0.3s ease;
}

.app.dark {
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: #f8fafc;
}

.app.light {
  background: linear-gradient(135deg, #f8fafc, #e2e8f0);
  color: #0f172a;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
  background: rgba(15, 23, 42, 0.95);
  position: sticky;
  top: 0;
  z-index: 10;
}

.app.light .navbar {
  background: rgba(255, 255, 255, 0.95);
}

.navbar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #38bdf8;
  font-size: 1.2rem;
  font-weight: bold;
  text-decoration: none;
}

.navbar-logo img {
  width: 42px;
  height: 42px;
  object-fit: contain;
  border-radius: 12px;
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.navbar-links {
  display: flex;
  gap: 20px;
}

.navbar-links a {
  color: white;
  text-decoration: none;
}

.app.light .navbar-links a,
.app.light .navbar-logo span {
  color: #0f172a;
}

.navbar-links a:hover {
  color: #38bdf8;
}

.theme-toggle {
  border: none;
  border-radius: 999px;
  padding: 8px 12px;
  cursor: pointer;
  background: rgba(255, 255, 255, 0.14);
}
.section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 80px 24px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}

.hero {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 80px 0%;
  gap: 50px;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 80px 8%;
}

.hero-text {
  flex: 1;
  text-align: left;
}

.greeting {
  color: #60a5fa;
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 10px;
}

.hero h1 {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  margin-bottom: 20px;
  text-align: left;
}

.hero h2 {
  color: #3b82f6;
  margin-bottom: 20px;
  text-align: left;
}

.description {
  max-width: 500px;
  line-height: 1.8;
  color: #cbd5e1;
  text-align: left;
}

.app.light .description {
  color: #334155;
}

.hero-buttons {
  margin-top: 30px;
  display: flex;
  justify-content: flex-start;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-button {
  display: inline-block;
  padding: 10px 18px;
  background: #38bdf8;
  color: #082f49;
  border-radius: 999px;
  text-decoration: none;
  font-weight: bold;
}

.hero-button.secondary {
  background: transparent;
  color: #f8fafc;
  border: 2px solid #3b82f6;
}

.app.light .hero-button.secondary {
  color: #0f172a;
}

.social-icons {
  margin-top: 30px;
  display: flex;
  justify-content: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.social-icons a {
  color: white;
  font-size: 1rem;
  transition: 0.3s;
  text-decoration: none;
}

.app.light .social-icons a {
  color: #0f172a;
}

.social-icons a:hover {
  color: #3b82f6;
}

.hero-image {
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image img {
  width: min(320px, 100%);
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 50%;
  border: 4px solid rgba(56, 189, 248, 0.5);
}

@media (max-width: 768px) {
  .hero {
    flex-direction: column-reverse;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
  }

  .hero-text,
  .hero h1,
  .hero h2,
  .description {
    text-align: center;
  }

  .hero-buttons,
  .social-icons {
    justify-content: center;
  }

  .hero-image img {
    width: 250px;
  }
}


.about {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 50px;
  padding: 100px 0px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.about-text {
  max-width: 580px;
}

.section-label {
  display: inline-block;
  margin-bottom: 12px;
  color: #38bdf8;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.about-text h2 {
  font-size: clamp(2rem, 3vw, 2.8rem);
  margin-bottom: 18px;
}

.about-description {
  line-height: 1.9;
  color: #cbd5e1;
  font-size: 1.02rem;
}

.app.light .about-description {
  color: #334155;
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.about-stat {
  padding: 24px 18px;
  border-radius: 20px;
  background: linear-gradient(145deg, rgba(56, 189, 248, 0.16), rgba(255,255,255,0.06));
  border: 1px solid rgba(56, 189, 248, 0.2);
  text-align: center;
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.16);
}

.app.light .about-stat {
  background: linear-gradient(145deg, rgba(56, 189, 248, 0.12), rgba(255,255,255,0.9));
  border-color: rgba(56, 189, 248, 0.25);
  box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
}

.about-stat h3 {
  color: #38bdf8;
  font-size: 1.9rem;
  margin-bottom: 8px;
}

.about-stat p {
  margin: 0;
  color: #e2e8f0;
  font-weight: 600;
}

.app.light .about-stat p {
  color: #334155;
}

@media (max-width: 768px) {
  .about {
    grid-template-columns: 1fr;
    padding: 70px 20px;
    text-align: center;
    gap: 28px;
  }

  .about-text {
    margin: 0 auto;
  }

  .about-description {
    margin: 0 auto;
  }

  .about-stats {
    grid-template-columns: 1fr;
  }
}